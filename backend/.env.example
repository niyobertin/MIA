PORT=4000
# Postgres.app / local Homebrew — trust auth for your macOS user (no password):
DATABASE_URL=postgresql://apple@localhost:5432/mia
# Generate with: openssl rand -hex 32  (required when NODE_ENV=production)
JWT_SECRET=change-me-to-a-long-random-secret
# Comma-separated list of allowed web origins, e.g. https://dashboard.example.com
CORS_ORIGIN=*
# Number of reverse proxies in front of the API (0 if exposed directly)
TRUST_PROXY=1
NODE_ENV=development
TYPEORM_SYNC=true
TYPEORM_LOGGING=false
ALLOW_DESTRUCTIVE_SCHEMA=false
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
# Email for PIN reset codes. Without SMTP_HOST, development prints codes to the API log; production cannot send them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MIA <no-reply@example.com>
# Super admin. Production ignores PLATFORM_REQUIRE_2FA and always requires two-factor sign-in.
PLATFORM_REQUIRE_2FA=true
PLATFORM_SESSION_EXPIRES=2h
# First super admin in production, used by npm run platform:seed
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
