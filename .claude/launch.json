{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "MIA API (local)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 4000
    },
    {
      "name": "MIA app (web, local API)",
      "runtimeExecutable": "env",
      "runtimeArgs": ["EXPO_PUBLIC_API_URL=http://localhost:4000", "npx", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
