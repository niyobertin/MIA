# App Configuration
EXPO_PUBLIC_APP_NAME=MIA
EXPO_PUBLIC_APP_VERSION=1.0.0

# Custom MIA backend (replaces Supabase)
# Use your computer LAN IP for a physical phone, e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Default Business Settings
EXPO_PUBLIC_DEFAULT_CURRENCY=RWF
EXPO_PUBLIC_DEFAULT_COUNTRY=Rwanda
EXPO_PUBLIC_DEFAULT_TIMEZONE=Africa/Kigali
