# Supabase Configuration
# Use Project Settings → API Keys:
#   - Preferred: sb_publishable_... (new publishable key)
#   - Or legacy: eyJ... (anon JWT)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# App Configuration
EXPO_PUBLIC_APP_NAME=MIA
EXPO_PUBLIC_APP_VERSION=1.0.0

# Default Business Settings
EXPO_PUBLIC_DEFAULT_CURRENCY=RWF
EXPO_PUBLIC_DEFAULT_COUNTRY=Rwanda
EXPO_PUBLIC_DEFAULT_TIMEZONE=Africa/Kigali