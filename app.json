{
  "expo": {
    "name": "MIA",
    "slug": "mia",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/mia.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/mia.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mia.app",
      "requireFullScreen": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mia.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mia.app",
      "softwareKeyboardLayoutMode": "resize",
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#f1f5f9",
        "translucent": false
      }
    },
    "web": {
      "favicon": "./assets/mia.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-document-picker"
    ],
    "scheme": "mia",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "5992e7b2-76d4-4af9-9d1e-4eb0a7d458f5"
      }
    },
    "owner": "tangahub"
  }
}
