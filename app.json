{
  "expo": {
    "name": "MIA",
    "slug": "mia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mia.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mia.app",
      "softwareKeyboardLayoutMode": "resize",
      "statusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#f1f5f9",
        "translucent": false
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization"
    ],
    "scheme": "mia",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c44ccf9b-0884-4aa6-9254-6f8a3e66036f"
      }
    },
    "owner": "niyobertin"
  }
}
